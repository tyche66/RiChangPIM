# Database
POSTGRES_PASSWORD=pim_password
POSTGRES_USER=pim
POSTGRES_DB=ai_pim
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
UVICORN_WORKERS=2
# 集成测试专用库（docker-compose 的 postgres 首次启动会自动创建 ai_pim_test）。
# 服务器部署时若测试库名不含 "test"，需另设 AI_PIM_TEST_DB_APPROVED=1。
TEST_DATABASE_URL=postgresql+asyncpg://pim:pim_password@localhost:5432/ai_pim_test

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production_ai_pim_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# MinIO
MINIO_ROOT_USER=pim_minio
MINIO_ROOT_PASSWORD=pim_minio_secret

# AI
AI_ADAPTER=none
AI_API_URL=
AI_API_KEY=

# Local OCR compensation (none or tesseract)
OCR_ADAPTER=none
OCR_API_URL=http://ocr:8080
OCR_TIMEOUT=300
