# Keep local configuration and heavyweight local tooling out of the image.
# The Docker build context for the backend is ./backend, so the repository-root
# .dockerignore does not apply here.
.env
.env.*
!.env.example
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.pytest_cache
backend.log
*.log
回收站/
