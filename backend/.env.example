# ============================================================================
# AI-PIM 后端本地环境变量模板（复制为 backend/.env 后按需修改）。
#
# 说明：
# - 本文件仅用于「本地直接运行后端」（venv + 本地/容器化的依赖服务），
#   由 app/core/config.py 相对项目根解析加载，与启动目录（CWD）无关。
# - 服务器 / Docker / K8s 部署时，优先使用真实环境变量注入，无需此文件。
# - 切勿提交含真实密钥的 .env；本 .env.example 仅含本地默认占位值。
# ============================================================================

# ---- 数据库（PostgreSQL + pgvector）----
DATABASE_URL=postgresql://pim:pim_password@localhost:5432/ai_pim
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
UVICORN_WORKERS=2

# 集成测试专用库（名字含 "test"，conftest 才会允许落库/清库）。
# 默认 docker-compose 启动的 postgres 会自动建 ai_pim_test；指向任意可达安全测试库即可。
# 服务器部署时设为专用测试库地址；若库名不含 "test"，需另设 AI_PIM_TEST_DB_APPROVED=1。
TEST_DATABASE_URL=postgresql+asyncpg://pim:pim_password@localhost:5432/ai_pim_test
AI_PIM_TEST_DB_APPROVED=0

# ---- 缓存 ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
# 生产务必替换为强随机值，并通过环境变量注入，不要写死在文件中。
JWT_SECRET=change_me_in_production_ai_pim_local
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# ---- 对象存储 MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=pim_minio
MINIO_SECRET_KEY=pim_minio_secret
MINIO_BUCKET=ai-pim
MINIO_SECURE=false

# ---- 文档转换（Gotenberg，用于报价单 PDF）----
GOTENBERG_URL=http://localhost:8002

# ---- AI 能力中心 ----
# none = 未配置（接口返回「AI 能力中心未配置」）。
# openai = 需同时填写 AI_API_URL / AI_API_KEY。
AI_ADAPTER=none
AI_API_URL=
AI_API_KEY=

OCR_ADAPTER=none
OCR_API_URL=http://localhost:8080
OCR_TIMEOUT=300
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
AI_EMBEDDING_VERSION=
AI_EMBEDDING_CACHE_ENABLED=false
AI_EMBEDDING_CACHE_TTL_SECONDS=3600
AI_EMBEDDING_CACHE_MAX_ITEMS=10000
AI_EMBEDDING_DIM=2048
AI_TIMEOUT=30
AI_RAG_TOP_K=8
AI_RAG_MIN_SCORE=0.65
AI_RAG_CHUNK_SIZE=600
AI_RAG_CHUNK_OVERLAP=80

# ---- AI 限额与成本治理（P1 默认 noop）----
AI_QUOTA_CHECK_ENABLED=false
AI_QUOTA_CHECKER_BACKEND=noop
AI_LIMIT_TPS=10
AI_LIMIT_CONCURRENT_STREAMS=40
AI_LIMIT_USER_PER_MIN=20
AI_LIMIT_USER_PER_DAY=500
AI_LIMIT_USER_DAILY_TOKENS=100000
AI_LIMIT_USER_DAILY_COST_USD=5.0
AI_LIMIT_SYSTEM_DAILY_COST_USD=100.0
AI_BUDGET_NOTIFY_RATIO=0.8
AI_BUDGET_DISABLE_RATIO=1.0
AI_ESTIMATED_PRICE_TABLE_PATH=
AI_PRICING_BACKEND=
